# Copia este archivo a .env y completa los valores.
# Supabase: Project Settings → API → Project URL y anon public key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 (Admin → Flujo de datos → ID de medición, ej. G-XXXXXXXX)
# Solo se carga tras aceptar cookies en el banner del sitio.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 panel (recomendado para este sitio, Colombia, sin Ads):
# - Google signals: OFF
# - User-ID / datos proporcionados por usuarios: OFF
# - Personalización de anuncios: OFF
# - Ubicación/dispositivo granular: ON solo si quieres ciudad; OFF si mínima recogida
# - Checkbox de consentimiento: marcar DESPUÉS de publicar /privacidad + banner

# Supabase Dashboard (antes de probar login / CMS):
# 1. Authentication → Providers → Email: habilitar email/contraseña
# 2. Authentication → Users: crear usuario administrador
# 3. Table admin_users: fila con user_id + role owner|admin
# 4. RLS admin_users: SOLO "auth.uid() = user_id" para SELECT
#    NO uses políticas que consulten admin_users dentro de admin_users
#    (causa: infinite recursion detected in policy)
# 5. Storage: bucket público "blog-images" (write autenticado)
# 6. Authentication → URL Configuration:
#    - Site URL: http://localhost:3000
#    - Redirect URLs: http://localhost:3000/**
# 7. posts.sort_order (integer not null default 0) — orden manual en /blog
#    Si todos tienen 0, reordenar una vez por fecha:
#    with ranked as (
#      select id, row_number() over (order by published_at desc nulls last, created_at desc) as rn
#      from public.posts
#    )
#    update public.posts p set sort_order = ranked.rn from ranked where p.id = ranked.id;
# 8. posts.meta_title / meta_description (text null) — SEO por post (ya en esquema)
